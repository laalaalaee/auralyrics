{
  "name": "auralyrics",
  "productName": "Auralyrics",
  "version": "2.1.0",
  "description": "Synced full-screen lyrics and an ambient screen-edge glow for Windows, driven by whatever is playing in Spotify, Apple Music or your browser.",
  "main": "main.js",
  "keywords": [
    "synced lyrics",
    "lyrics",
    "lyrics app",
    "full screen lyrics",
    "music visualizer",
    "ambient glow",
    "screen glow",
    "spotify lyrics",
    "apple music lyrics",
    "youtube music lyrics",
    "karaoke",
    "lock screen lyrics",
    "windows",
    "electron",
    "lrclib"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.auralyrics",
    "productName": "Auralyrics",
    "copyright": "Copyright © 2026 Auralyrics. PolyForm Noncommercial 1.0.0.",
    "publish": [
      {
        "provider": "github",
        "owner": "laalaalaee",
        "repo": "auralyrics"
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!site/**",
      "!tests/**",
      "!.github/**",
      "!dev-gallery.html",
      "!dev-glow.html",
      "!*.md"
    ],
    "asarUnpack": [
      "media.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Auralyrics",
      "artifactName": "Auralyrics-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Auralyrics-${version}-portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
